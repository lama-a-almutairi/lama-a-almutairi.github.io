---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ title: "Home" }}>
	<section class="grid gap-8 sm:grid-cols-[1fr_11rem]">
		<img
			alt="Lama Almutairi"
			class="aspect-square w-44 rounded-full object-cover sm:order-last"
			src="/profile_image.jpeg"
		/>
		<div>
			<h1 class="title mb-12">Lama Almutairi</h1>
			<p class="mb-4">
				I’m a Research Assistant at KACST Riyadh, Saudi Arabia. I work on agentic AI pipelines and
				multilingual retrieval, with earlier work in NLP, multimodal models and machine learning.
			</p>
			<SocialList />
		</div>
	</section>
</PageLayout>
