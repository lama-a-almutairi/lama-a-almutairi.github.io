---
interface Props {
	date?: string;
	description: string;
	image?: string;
	imageAlt?: string;
	org?: string;
	title: string;
}

const { date, description, image, imageAlt = "", org, title } = Astro.props;
---

<li class="grid gap-4 sm:grid-cols-[14rem_1fr]">
	{
		image ? (
			<img alt={imageAlt} class="aspect-video w-full rounded object-cover" src={image} />
		) : (
			<div class="border-muted text-muted flex aspect-video w-full items-center justify-center rounded border-2 border-dashed text-xs">
				Image
			</div>
		)
	}
	<div>
		<h2 class="text-accent-2 font-semibold">{title}</h2>
		{
			(org || date) && (
				<p class="text-muted mt-1 text-xs">{[org, date].filter(Boolean).join(" · ")}</p>
			)
		}
		<p class="mt-1">{description}</p>
	</div>
</li>
